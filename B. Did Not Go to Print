#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        string s;
        cin>>n>>s;
        vector<int> st;
        vector<bool> bad(n+1,false);
        for(int i=1;i<=n;i++){
            if(s[i-1]=='1'){
                st.push_back(i);
                bad[i]=true;
            }
            else if(s[i-1]=='2'&&!st.empty()){
                bad[st.back()]=false;
                st.pop_back();
                bad[i]=true;
            }
        }
        int k=0;
        for(int i=1;i<=n;i++)if(bad[i])k++;
        cout<<k<<endl;
        for(int i=1;i<=n;i++)if(bad[i])cout<<i<<" ";
        cout<<endl;
    }
}
